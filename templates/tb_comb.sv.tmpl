// 组合 micro-tb 模板 —— 门控极性/截断/常量绑定类发现（L2 数据流实证）
// 用法：把疑点表达式原样抄进 vuln 分支，按树内预言机修好的版本抄进 twin 分支，
//       给定输入常数，比较输出。参考活样板: examples/hmac_wipe_gate
// 注意：Verilator 4.210 —— 无时序控制、无 wait；纯组合即可。
module tb (
  input  logic clk_i,          // 引擎要求 clk 端口存在（可不用）
  output logic test_done_o,
  output logic vuln_deviation_o,   // 1 = vuln 表现偏离安全预期
  output logic twin_secure_o,      // 1 = twin 表现符合安全预期
  output logic test_confirmed_o    // 1 = 两者同时成立 = 洞确认
);

  // ===== 输入常数（按发现场景填） =====
  localparam logic [__W-1:0] IN_A = __VALUE_A;
  localparam logic [__W-1:0] IN_B = __VALUE_B;

  // ===== vuln 分支：原样抄 RTL 疑点表达式 =====
  // 例（hmac wipe gate）: logic we_v = addr_hit8 && reg_we && reg_error;
  logic [__W-1:0] out_v = __VULN_EXPR;

  // ===== twin 分支：按树内预言机修复（注释写依据！） =====
  // 依据: <file:line 的注释/SVA/hjson 原文>
  // 例: 逻辑 we_t = addr_hit8 && reg_we && !reg_error;  // 同文件其余 we 均为 !reg_error
  logic [__W-1:0] out_t = __TWIN_EXPR;

  // ===== 判定 =====
  assign vuln_deviation_o = (out_v != __EXPECTED_SECURE);
  assign twin_secure_o    = (out_t == __EXPECTED_SECURE);
  assign test_confirmed_o = vuln_deviation_o && twin_secure_o;
  assign test_done_o      = 1'b1;

endmodule
